# Copy to backend/.env and adjust for your environment.
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-flask-secret
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=604800

# Local MongoDB, or a MongoDB Atlas SRV connection string in production.
MONGO_URI=mongodb://localhost:27017
DB_NAME=blogsphere

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated emails that receive the admin role on registration.
ADMIN_EMAILS=admin@blogsphere.local

# Absolute backend origin (no trailing slash). Leave blank in local development.
PUBLIC_API_URL=
UPLOAD_FOLDER=uploads
PORT=5000
